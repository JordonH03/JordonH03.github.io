---
import { GitHubLogoIcon, GlobeIcon } from '@radix-ui/react-icons'
import Badge from './Badge.astro'

const { demo, description, github, name, tools } = Astro.props as IProjectProps

interface IProjectProps {
    demo: string
    description: string
    github: string
    name: string
    tools: string[]
}
---

<div class="grid grid-cols-1 grid-rows-[repeat(3, auto)] gap-y-4 p-4 border border-glow rounded-xl bg-light-page/30 backdrop-blur-xl">
    <div class="row-start-1 flex flex-row gap-x-4 justify-start items-center">
        <h3 class="text-base font-normal text-light-header dark:text-dark-header">{name}</h3>
        <span class="flex flex-row gap-x-2 justify-start items-center">
            {
                demo && (
                    <a
                        aria-label='View live project, opens in a new tab'
                        href={demo}
                        target='_blank'
                        rel='noreferrer'
                    >
                        <GlobeIcon height={16} width={16} />
                    </a>
                )
            }
            {
                github && (
                    <a
                        aria-label='View Github repository, opens in a new tab'
                        href={github}
                        target='_blank'
                        rel='noreferrer'
                    >
                        <GitHubLogoIcon height={16} width={16} />
                    </a>
                )
            }
        </span>
    </div>
    <div class="row-start-2 font-sans text-sm">
        <p>{description}</p>
    </div>
    <div class="row-start-3 flex flex-row flex-wrap gap-x-2 gap-y-1">
        {tools.map((tool) => <Badge content={tool} />)}
    </div>
</div>
