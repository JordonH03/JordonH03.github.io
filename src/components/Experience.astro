---
import { ExternalLinkIcon } from '@radix-ui/react-icons'
import Badge from './Badge.astro'

interface IExperienceProps {
    company: string
    description: string[]
    end: string
    link: string | null
    position: string
    start: string
    tools: string[]
}

const { company, description, end, link, position, start, tools } =
    Astro.props as IExperienceProps

const srLabel = `Learn more about ${company}. Opens in a new tab.`
---

<div class="grid grid-cols-1 grid-rows-[auto_1fr] md:grid-cols-[0.25fr_1fr] md:grid-rows-1">
    <span class="font-sans text-sm text-light-body dark:text-dark-body h-fit md:leading-6">
        {start} &ndash; {end}
    </span>
    <div class="md:col-start-2 grid grid-cols-1 grid-rows-[repeat(3, auto)] gap-y-4">
        <div class="row-start-1 grid grid-rows-[auto_auto] gap-y-1">
            {
                link ? (
                    <h3 class="flex flex-row justify-start items-center gap-x-1 w-fit font-sans text-base text-light-header dark:text-dark-header hover:underline">
                        <a
                            aria-label={srLabel}
                            href={link}
                            rel='noopener noreferrer'
                            target='_blank'
                        >
                            {company}
                            <ExternalLinkIcon
                                className='inline-block'
                                height={16}
                                width={16}
                            />
                        </a>
                    </h3>
                ) : (
                    <h3 class="w-fit font-sans text-base text-light-header dark:text-dark-header">{company}</h3>
                )
            }
            <span class="text-sm text-light-header dark:text-dark-header">{position}</span>
        </div>
        <div class="row-start-2 font-sans text-light-body dark:text-dark-body text-sm space-y-2">
            <ul class="pl-4 list-outside list-image-[url('/assets/bullet.svg')]">
                {description.map((exp => (
                    <li class="pl-2">{exp}</li>
                )))}
            </ul>
        </div>
        <div class="row-start-3 flex flex-row flex-wrap gap-x-2 gap-y-1">
            {tools?.map((tool) => <Badge content={tool} />)}
        </div>
    </div>
</div>
