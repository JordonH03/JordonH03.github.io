---
import { Cross1Icon, HamburgerMenuIcon } from '@radix-ui/react-icons'
---

<header class='w-full px-6 py-2 sticky top-0 bg-light-page/80 dark:bg-dark-page/80 backdrop-blur-md z-20 border-b border-b-light-header dark:border-b-dark-header'>
    <div class="flex flex-row items-center justify-between">
        <span
            class='text-light-header dark:text-dark-header flex items-center justify-center font-serif text-3xl italic'>
            J
        </span>
        <nav class="hidden md:flex justify-self-center flex-row items-center justify-between w-full max-w-80">
            <a
                href='#about'
                class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                About
            </a>
            <a
                href='#experience'
                class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                Experience
            </a>
            <a
                href='#projects'
                class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                Projects
            </a>
        </nav>
        <div class="md:hidden flex flex-col items-end">
            <nav class="hidden">
                <a
                    href='#about'
                    class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                    About
                </a>
                <a
                    href='#experience'
                    class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                    Experience
                </a>
                <a
                    href='#projects'
                    class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
                    Projects
                </a>
            </nav>
        </div>
        <button
            id="menu-button"
            aria-expanded="false"
            aria-label="Toggle menu"
            class="inline-block md:hidden"
        >
            <HamburgerMenuIcon className='menu-close text-light-header dark:text-dark-header hover:cursor-pointer' />
            <Cross1Icon className='menu-open hidden text-light-header dark:text-dark-header hover:cursor-pointer' />
        </button>
    </div>
    <nav 
        id="mobile-nav"
        class="hidden md:hidden flex-col items-start mt-2 contact-list justify-self-end"
    >
        <a
            href='#about'
            class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
            About
        </a>
        <a
            href='#experience'
            class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
            Experience
        </a>
        <a
            href='#projects'
            class='text-light-header dark:text-dark-header font-sans text-md font-light italic hover:underline'>
            Projects
        </a>
    </nav>
</header>

<script>
    const menuButton = document.getElementById('menu-button');
    const menuOpenIcon = menuButton?.querySelector('.menu-open');
    const menuCloseIcon = menuButton?.querySelector('.menu-close');

    const mobileNav = document.getElementById('mobile-nav');

    menuButton?.addEventListener('click', () => {
        const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isExpanded));
        menuOpenIcon?.classList.toggle('hidden');
        menuCloseIcon?.classList.toggle('hidden');
        mobileNav?.classList.toggle('hidden');
        mobileNav?.classList.toggle('flex');
    });

    const contactIcon = document.querySelector('.contact-list .IconAt');
    const contactsCont = document.getElementById('contacts');

    contactIcon?.addEventListener('click', () => {
        contactsCont?.classList.toggle('hidden');
    });
</script>
